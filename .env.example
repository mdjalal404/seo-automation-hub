# ---------------------------------------------------------------------------
# SEO Automation Hub — environment configuration
# Copy to .env.local (local) or set in your hosting provider. Never commit real values.
#
# PUBLIC (embedded in browser bundles — not secret):
#   NEXT_PUBLIC_*
# SERVER-ONLY SECRETS (never prefix with NEXT_PUBLIC_):
#   SUPABASE_SERVICE_ROLE_KEY, CREDENTIAL_ENCRYPTION_KEY*, CRON_SECRET
# For local development, `npm run setup:local` writes .env.local for you.
# ---------------------------------------------------------------------------

# development | test | production (defaults to production when NODE_ENV=production)
APP_ENV=development

# Public base URL of this app (used for auth email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings → API). The anon key is public; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used only by server code after explicit authorization.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored WordPress credentials unrecoverable (sites must be reconnected).
CREDENTIAL_ENCRYPTION_KEY=
# Identifier stored with each ciphertext; change it when rotating keys.
CREDENTIAL_ENCRYPTION_KEY_ID=k1
# Old keys kept for decryption during rotation: "k0:<base64>,k-1:<base64>"
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# Bearer token required by /api/cron/process-jobs (Vercel Cron sends it automatically).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Background worker poll interval (npm run worker)
WORKER_POLL_INTERVAL_MS=5000

# DEVELOPMENT ONLY: allow connecting to localhost/private-network sites (the local CMS mocks).
# Always ignored when APP_ENV=production.
ALLOW_PRIVATE_NETWORK_TARGETS=false

# DEVELOPMENT ONLY: mock WordPress server (npm run mock:wp) test credentials.
MOCK_WP_PORT=8787
MOCK_WP_USER=demo-editor
# 24 letters/digits; a test value for the mock only — never a real WordPress password.
MOCK_WP_APP_PASSWORD=
# DEVELOPMENT ONLY: password for the seeded demo@example.test user (npm run seed:dev).
DEMO_USER_PASSWORD=

# DEVELOPMENT ONLY: Webflow / Shopify / custom CMS mocks (npm run mock:cms). Test tokens for the mocks only.
MOCK_WEBFLOW_PORT=8788
MOCK_WEBFLOW_TOKEN=
MOCK_SHOPIFY_PORT=8789
# Must look like a Shopify token: shpat_ followed by letters/digits.
MOCK_SHOPIFY_TOKEN=
MOCK_CUSTOM_PORT=8790
MOCK_CUSTOM_TOKEN=
# DEVELOPMENT ONLY: point the Webflow / Shopify adapters at the local mocks instead of
# api.webflow.com and <shop>.myshopify.com. Always ignored when APP_ENV=production.
WEBFLOW_API_BASE_URL=
SHOPIFY_ADMIN_BASE_URL=

# Optional: AI-written content estimate. By default a built-in heuristic runs locally.
# Set AI_DETECTION_PROVIDER=sapling with a server-only SAPLING_API_KEY to use Sapling's AI
# detector instead (article text is then sent to Sapling during validation).
AI_DETECTION_PROVIDER=
SAPLING_API_KEY=

# Optional: debug | info (default) | silent
LOG_LEVEL=info
