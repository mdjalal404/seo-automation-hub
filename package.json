{
  "name": "seo-automation-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node --env-file=.env.local scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "mock:wp": "tsx --env-file-if-exists=.env.local scripts/mock-wordpress.ts",
    "mock:cms": "tsx --env-file-if-exists=.env.local scripts/mock-cms.ts",
    "setup:local": "node scripts/setup-local-env.mjs",
    "seed:dev": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "entities": "^9.0.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
